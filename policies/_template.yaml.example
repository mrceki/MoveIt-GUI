# Copy to ~/moveit_gui_policies/<name>.yaml and adapt. Files ending in .example are ignored.
# The GUI does not load models: it checks this manifest, then starts and stops the real runner:
#   ros2 run my_robot_policy run_policy.py --model ... --normalization ... --config ...
#        --robot-config ... --robot-controller <backend> [recording arguments]
name: scrape_ppo_v4
description: PPO scraping policy (Fx Fz dy dz Ty)
algorithm: PPO
backend: servo_admittance         # impedance | servo_admittance; passed as --robot-controller
required_mode: admittance         # must already be active: add a controller step before the policy
required_tcp: spatula_tip         # the active TCP must be this one
# required_frames: [vial_rack]    # only if the policy truly depends on a saved workcell frame
control_hz: 5.0                   # must match robot_config policy.control_hz
requires_ft: true
model: ~/policies/v4/model.zip
normalization: ~/policies/v4/vec_normalize.pkl
training_config: ~/policies/v4/config.yaml
robot_config: ~/ur7e_ws/src/ur7e_robotiq/ur7e_robotiq_bringup/config/ur7e_policy_deployment.yaml
entrypoint: run_policy            # run_policy | run_scraping_policy
duration: 8.0
stop_signal: SIGINT
